 "mechanism": {
  "switch": "sent_path_audit",
  "values": [
   "SAMPLED",
   "ADAPTIVE"
  ],
  "default": "SAMPLED",
  "rule": "ADAPTIVE walks exactly the SAMPLED native sample sequence of the sent path; a sample is skipped only when, from the last exactly checked sample (anchor), every constraint keeps margin - sum_v c_v |q_v - anchor_v| >= 1 um; every other sample is checked exactly (EXACT or TWO_LEVEL), so decisions and the first failing sample equal SAMPLED",
  "constraints": "one per pair of moving rigid groups (joints moving exactly one side), one per moving group against all static bodies, one per link box and payload corners against the site workspace; margin = min(distance lower bound - pair limit, 0.05 m); lower bound = max(body-sphere distance, conservative AABB distance, exact FCL distance of this check, FCL started at limit + 0.05 m + 1 mm while recording)",
  "lever": "per joint: distance from the joint axis to the farthest point of the group, bounded by the chain of joint-origin translations (plus prismatic travel) and the body radius in its link frame; prismatic joints coefficient 1",
  "scope": "physical single carton, no contact permission, no support (approach; loaded return without supports); contact and supported segments stay SAMPLED; the worker refuses ADAPTIVE elsewhere (SENT_PATH_AUDIT_SCOPE_INVALID)",
  "continuous_guarantee": "every native sample is checked (>= 2.4 mm) or proven (>= its pair limit); consecutive probe states move any pair <= 1 mm (prepare), so every sent state keeps >= 1.4 mm: continuous_swept_proof=BOUNDED_DISPLACEMENT_1_4_MM per segment for SAMPLED and ADAPTIVE (null when rejected); the native checker evidence keeps continuous_swept_proof=false",
  "time_scaling": "prepare chooses the send scale (SEND_SLOWDOWN_STEPS) before the audit, so each segment is audited once; uniform scaling keeps the probe-state bound (unit test)",
  "files": [
   "ros2/m710_moveit_backend/src/clearance_workspace.h (levers, constraints, provenClear)",
   "ros2/m710_moveit_backend/src/clearance.h (checkPath ADAPTIVE, evidence)",
   "ros2/m710_moveit_backend/src/eco65_single_carton.h (adaptiveEligible, workspaceMargins)",
   "ros2/m710_moveit_backend/src/worker.cpp (scope, capability)",
   "ros2/m710_moveit_backend/src/clearance_test.cpp (adaptive)",
   "single_carton/config.py",
   "single_carton/planner.py (audit_method, audit_summary)",
   "docs/sent_path_adaptive_audit.md"
  ]
 },
