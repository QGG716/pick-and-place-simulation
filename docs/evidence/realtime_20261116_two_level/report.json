  "proxy_level": [
   "per-body bounding sphere: centre = local AABB centre, radius = max convex-vertex distance (local AABB half-diagonal for non-convex shapes), inflated by 1e-9 relative + 1e-9 m",
   "rigid groups (bodies joined by fixed joints) with one group sphere",
   "static bounding-volume tree over static world bodies",
   "pairs whose relative transform never changes are decided once per scene (constant pairs)"
  ],
  "exact_level": "every pair not cleared by a proxy goes, in the original pair-index order, through the unchanged conservative AABB test and the exact fcl::distance against the same required clearance; the first failing pair and its reason are therefore identical to EXACT",
  "proxy_soundness": "a proxy only clears a pair when sphere (or group-sphere / static-tree) distance > pair limit (+ search payload reserve in the search phase) + 1 mm; spheres contain every vertex of the convex solid, so the solids are never closer; proxies never reject, every rejection comes from the exact level",
  "other": "robot convex geometry cached per process; RobotState copy skipped when collision transforms are not dirty",
