+      if(!rules){++waypoint_audit_.state_rule_fallbacks;return false;}
+    }
+    ++waypoint_audit_.proven;return true;
+  }
+  // After `state` passed the exact predicate (its workspace check is the most recent one).
+  void waypointPassed(const moveit::core::RobotState& state,const std::vector<double>& q) {
+    if(!adaptive_solution_)return;
+    waypoint_anchor_=q;anchorConstraints(state,waypoint_constraints_);waypoint_anchored_=true;++waypoint_audit_.anchors;
+  }
+  Json waypointEvidence() const {
+    return {{"proven_waypoints",waypoint_audit_.proven},{"anchors",waypoint_audit_.anchors},
+      {"state_rule_checks",waypoint_audit_.state_rule_checks},{"state_rule_fallbacks",waypoint_audit_.state_rule_fallbacks},
+      {"state_rule_s",waypoint_audit_.state_rule_s},{"proof_epsilon_m",kAdaptiveProofEpsilon},
+      {"skip_rule",adaptive_solution_rules_?"PER_GROUP_PAIR_LEVER_BOUND_FROM_LAST_EXACT_WAYPOINT_PLUS_EXACT_SINGLE_CARTON_RULES":"PER_GROUP_PAIR_LEVER_BOUND_FROM_LAST_EXACT_WAYPOINT"}};
+  }
   bool proven(const std::vector<ClearanceWorkspace::Constraint>& constraints,const std::vector<double>& q,const std::vector<double>& anchor) {
