+  bool waypointProven(moveit::core::RobotState& probe,const std::vector<double>& q) {
+    if(!adaptive_solution_||!waypoint_anchored_||nativeExpired(deadline_))return false;
+    probe.setJointGroupPositions(m710::nativeFrames().planning_group,q);
+    if(!probe.satisfiesBounds()||!proven(waypoint_constraints_,q,waypoint_anchor_))return false;
+    if(adaptive_solution_rules_) {
+      const auto t=Clock::now();probe.update();const bool rules=single_carton_->check(probe).is_null();
