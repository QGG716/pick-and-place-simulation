 "mechanisms": {
  "resident_workers": {
   "switch": "resident_workers",
   "default": false,
   "behaviour": "main worker and checker pool start at entry start (background) and stay; every worker is reset (sc_task_reset: fresh scene, handles, counters, task sessions, OMPL pipeline rebuilt, OMPL seed re-applied) after init and after every task; cancellation and timeouts by request id (worker M710_WORKER_CANCEL=1 reader thread expires the running request NativeDeadline); a worker not replying within 5 s of a cancel, failing its reset or init is retired, never given another request, reported and replaced in the background",
   "files": [
    "ros2/m710_moveit_backend/src/worker.cpp (sc_task_reset, out-of-band cancel)",
    "ros2/m710_moveit_backend/src/native_deadline.h (cancel)",
    "single_carton/resident.py"
   ]
  },
  "scene_handles": {
   "switch": "scene_handles",
   "default": false,
   "behaviour": "the task world is hashed once (register_scene); each worker gets it uploaded once (sc_scene_upload) and later requests carry scene_handle; the worker re-inserts the stored world, so every policy sees the same content; context() no longer hashes the world per request"
  },
  "async_evidence": {
   "switch": "async_evidence",
   "default": false,
   "behaviour": "requests still persisted synchronously before dispatch; replies, segment and sent-check evidence, observation npz, site-scene.json, geometry.json and complete-plan.json go through one ordered background writer; plan_cycle flushes before returning (PLAN_READY needs the plan evidence on disk) and execute flushes again; a write failure refuses PLAN_READY and execution (TASK_RECORD_UNAVAILABLE_NO_MOTION)"
  },
  "path_endpoint_reuse": {
   "switch": "path_endpoint_reuse",
   "default": false,
   "behaviour": "Clearance::checkPath already samples every edge including both endpoints, so the endpoint shared by two adjacent edges was checked twice; with the switch, a sample bitwise equal to the immediately preceding, passed sample is not checked again (the rule already used by the controlled-empty scope). The checked state set and every edge sampling rule are unchanged; physical single-carton scope only"
  },
  "binding_hash_cache": {
   "switch": "binding_hash_cache",
   "default": false,
   "behaviour": "a stored content hash is reused while device, inode, size, mtime_ns and ctime_ns are unchanged; any difference forces a full rehash; files changed within 0.1 s of hashing are never cached (timestamp granularity); per-file REUSED / REHASHED in the plan and the execute journal (AGENTS 3f)"
  }
 },
