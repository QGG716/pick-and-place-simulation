+# Schema 1.1 migration boundary.  These are explicit compatibility re-exports,
+# installed as part of importing online_planning itself; callers do not need to
+# import a shim first and no module attributes are changed dynamically.
+_LegacyPlannerBackend = PlannerBackend
+_LegacyPlanValidator = PlanValidator
+from unloading_contracts import (  # noqa: E402
+    ArtifactKind, BackendCapabilities, BackendHealth, BackendIdentity,
+    BackendProvenance, BoundaryMode, FailureDetails, FailureScope,
+    MotionBoundaryState, OperationalOutcome, OutcomeCategory,
+    PlanArtifactKind, PlanEnvelope, PlanStatus, PlanValidation,
+    PlanValidationResult, PlanValidator as _SharedPlanValidator,
+    PlanningCandidate, PlanningPath, PlanningRequest, PlanningResult,
+    PlanningWorldSnapshot, PlannerBackend as _SharedPlannerBackend,
+    ReplanReason, RobotStateRevision, SceneRevision, ValidationStatus,
+    scene_fingerprint,
+)
+
+# Consumer implementations defined above remain valid implementations of the
+# shared abstract interfaces.  New imports/classes see the shared identities.
+_SharedPlannerBackend.register(_LegacyPlannerBackend)
+_SharedPlanValidator.register(_LegacyPlanValidator)
+PlannerBackend = _SharedPlannerBackend
+PlanValidator = _SharedPlanValidator
+
