diff --git a/tests/test_shared_contract_identity.py b/tests/test_shared_contract_identity.py
new file mode 100644
--- /dev/null
+++ b/tests/test_shared_contract_identity.py
@@ -0,0 +1,35 @@
+"""Schema 1.1 must be the public identity for either import order."""
+from __future__ import annotations
+
+import subprocess
+import sys
+
+
+def _check(source: str) -> None:
+    subprocess.run([sys.executable, "-c", source], check=True)
+
+
+def test_shared_first_import_order() -> None:
+    _check("""
+import unloading_contracts as shared
+import unloading_sim.online_planning as online
+assert online.PlanningWorldSnapshot is shared.PlanningWorldSnapshot
+assert online.PlanningRequest is shared.PlanningRequest
+assert online.PlanningResult is shared.PlanningResult
+assert online.PlannerBackend is shared.PlannerBackend
+assert online.PlanValidator is shared.PlanValidator
+assert issubclass(online.ProviderNeutralPlanValidator, shared.PlanValidator)
+""")
+
+
+def test_online_first_import_order() -> None:
+    _check("""
+import unloading_sim.online_planning as online
+import unloading_contracts as shared
+assert online.PlanningWorldSnapshot is shared.PlanningWorldSnapshot
+assert online.PlanningRequest is shared.PlanningRequest
+assert online.PlanningResult is shared.PlanningResult
+assert online.PlannerBackend is shared.PlannerBackend
+assert online.PlanValidator is shared.PlanValidator
+assert issubclass(online.BackendPlanValidatorAdapter, shared.PlanValidator)
+""")
