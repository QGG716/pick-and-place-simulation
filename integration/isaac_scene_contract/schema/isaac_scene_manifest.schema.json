{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qgg716.example/schemas/isaac_scene_manifest_v1.json",
  "title": "IsaacSceneManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "source", "layout", "robot", "mechanisms",
    "cameras", "objects", "timing", "provenance", "dynamic_scene_fingerprint",
    "world_fingerprint", "manifest_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "isaac_scene_manifest_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "layout": {"type": "object"},
    "robot": {"type": "object"},
    "mechanisms": {"type": "object"},
    "cameras": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "objects": {"type": "array", "items": {"type": "object"}},
    "timing": {"type": "object"},
    "provenance": {"type": "object"},
    "dynamic_scene_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "world_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
