# Runtime source/config hashes must survive Windows and Linux checkouts.
*.py text eol=lf
*.yaml text eol=lf

# Preserve this hash-pinned inventory byte-for-byte in checkouts and archives.
assets/robots/realman_eco65/official/SOURCE_MANIFEST.json -text

*.STEP binary
*.stl binary
*.dae binary
*.glb binary
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.x_t binary
*.jt binary
*.dxf binary
*.zip binary
*.atr binary
*.geo binary
*.gm binary
*.gmnapx binary
*.gmnw binary
*.gri binary
*.r binary
*.wm binary
res/M-710iD_70/** binary

# Preserve the fixed upstream FANUC source bytes across Windows/Linux checkouts.
assets/robots/fanuc_m710id_70/official/LICENSES/Apache-2.0.txt text eol=lf
assets/robots/fanuc_m710id_70/official/fanuc_m710_description/package.xml text eol=lf
assets/robots/fanuc_m710id_70/official/fanuc_m710_description/robot/m710id_70.urdf.xacro binary
assets/robots/fanuc_m710id_70/official/fanuc_m710_description/urdf/m710id_70_urdf_macro.xacro binary
assets/robots/fanuc_m710id_70/official/fanuc_m710_description/robot/m710id_70.standalone.urdf.xacro text eol=lf
assets/robots/fanuc_m710id_70/official/fanuc_m710_description/urdf/*.urdf text eol=lf
assets/robots/fanuc_m710id_70/official/*.yaml text eol=lf
scripts/expand_official_m710id70_urdf.py text eol=lf

# The audited Wantai analysis manifest hashes the supplied CRLF byte stream.
# Keep those exact bytes on Linux as well as Windows instead of normalizing it.
assets/grippers/shanghai_wantai_three_zone/mass_properties.json binary
scripts/analyze_gripper_step.py binary

# M-710 replay bundles bind this adapter's raw source bytes. Preserve the
# validated mixed-newline byte stream so a clean Linux checkout can reuse it.
scripts/isaacsim_fanuc_replay.py binary
src/unloading_sim/isaac_bridge.py binary

# Shell entry points must remain runnable after a Windows checkout.
ros2/m710_moveit_backend/** text eol=lf

# Preserve raw performance evidence and its recorded hashes; log whitespace is data.
docs/validation/evidence/m710_moveit2_perf_20260928/** -text -whitespace

# Preserve rotating TCP and physical execution evidence bytes.
docs/validation/evidence/m710_moveit2_tcp_20260928/** -text -whitespace

# Preserve final execution-reference audit evidence identities.
docs/validation/evidence/m710_execution_gate_20260928/** -text -whitespace

# Keep this formal failed run and its source/actual-state identities byte-exact.
docs/validation/evidence/m710_native_cold_20261001/** -text -whitespace

# Preserve the second formal native-cold run, its worker and raw evidence.
docs/validation/evidence/m710_native_cold_20261002/** -text -whitespace

# Preserve validation-optimization measurements and the separate formal run.
docs/validation/evidence/m710_validation_optimization_20261002/** -text -whitespace

# Preserve the planning-only experiment measurements and generated trajectories.
docs/experiments/m710_top_row_planning_only_20261002/** -text -whitespace

# Preserve this planning-only experiment without text conversion.
docs/experiments/m710_top_row_planning_only_20261003/** -text -whitespace

# Preserve static-prior planning-only evidence without text conversion.
docs/experiments/m710_static_prior_fast_20261003/** -text -whitespace

