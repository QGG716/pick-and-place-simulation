{
  "enabled": true,
  "authority": "ADVISORY_ONLY_NO_GATE",
  "basis": "user 2026-11-28: '给当前工程加个QWEN的VLM作为大脑，一是要看懂周围的环境，主要是判断是否可以开始抓放以及箱堆是否存在坍塌风险，二是可以和操作员实时沟通，要有ASR+VLM+TTS'; VLM on the GPU server, verdict '只做提示', ASR/TTS '现场 PC 本地 CPU', voice '问答 + 语音停止'",
  "vlm": {
    "remote_config": "outputs/workbench/remote_vlm.local.json",
    "model": {
      "name": "Qwen/Qwen3.5-9B",
      "relative_directory": "Qwen3.5-9B",
      "hash_file": "configs/brain/qwen3.5-9b.sha256"
    },
    "max_pixels": 307200,
    "jpeg_quality": 90,
    "assess_max_new_tokens": 320,
    "chat_max_new_tokens": 160
  },
  "assessment": {
    "auto": true,
    "interval_s": 15,
    "announce": "ON_CHANGE"
  },
  "voice": {
    "enabled": true,
    "model_root": "outputs/brain/models",
    "hash_file": "configs/brain/voice_models.sha256",
    "input_device": null,
    "output_device": null,
    "stop_words": ["停止", "停下", "停车", "急停", "快停", "别动", "stop"],
    "vad": {"model": "silero_vad.onnx", "threshold": 0.5, "min_silence_s": 0.4, "min_speech_s": 0.2, "max_speech_s": 15},
    "asr": {
      "model": "sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/model.int8.onnx",
      "tokens": "sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/tokens.txt",
      "language": "zh",
      "num_threads": 2
    },
    "tts": {
      "model": "vits-melo-tts-zh_en/model.onnx",
      "lexicon": "vits-melo-tts-zh_en/lexicon.txt",
      "tokens": "vits-melo-tts-zh_en/tokens.txt",
      "dict_dir": "vits-melo-tts-zh_en/dict",
      "rule_fsts": ["vits-melo-tts-zh_en/date.fst", "vits-melo-tts-zh_en/phone.fst", "vits-melo-tts-zh_en/number.fst", "vits-melo-tts-zh_en/new_heteronym.fst"],
      "num_threads": 2,
      "speed": 1.0,
      "speaker_id": 0
    }
  },
  "record_root": "outputs/brain"
}
